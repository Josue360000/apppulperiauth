<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <ImageView
        android:id="@+id/imgUniversidad"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:contentDescription="Universidad"
        android:scaleType="fitCenter"
        app:srcCompat="@drawable/universidad" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pulperia UTH"
        android:textColor="#1B5E20"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btnProductos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Productos"
        android:backgroundTint="#1B5E20"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btnMovimientos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Movimientos"
        android:backgroundTint="#FBC02D"
        android:textColor="#1B5E20"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btnResumen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Resumen"
        android:backgroundTint="#1B5E20"
        android:textColor="#FFFFFF"/>
</LinearLayout>